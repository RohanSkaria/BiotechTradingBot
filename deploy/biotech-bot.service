[Unit]
Description=Biotech Trading Bot (APScheduler + Dexter weekly brief)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/code/BIOTECH-TRADING-BOT
Environment="PATH=/home/ubuntu/code/BIOTECH-TRADING-BOT/venv/bin:/home/ubuntu/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/ubuntu/code/BIOTECH-TRADING-BOT/venv/bin/python -m src.main
Restart=always
RestartSec=15
StandardOutput=append:/var/log/biotech-bot.log
StandardError=append:/var/log/biotech-bot.log

[Install]
WantedBy=multi-user.target
